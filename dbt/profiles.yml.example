# Copy this file to profiles.yml (gitignored) and adjust paths/project as needed.

market_microstructure:
  target: dev
  outputs:
    dev:
      type: duckdb
      path: dev.duckdb
      schema: main

    prod:
      type: bigquery
      method: service-account
      keyfile: ../gcp-service-account.json
      project: your-gcp-project-id
      dataset: market_data
      location: asia-south1
      threads: 4
